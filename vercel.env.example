APP_ENV=production
APP_DEBUG=false
APP_KEY=<el mismo de Render, o uno nuevo con: php artisan key:generate --show>
APP_URL=https://<TU-PROYECTO-BACKEND>.vercel.app
FRONTEND_URL=https://distrito3zona13.vercel.app
CORS_ALLOWED_ORIGINS=https://distrito3zona13.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=<host del pooler de Supabase>
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=<postgres.REF-DE-TU-PROYECTO>
DB_PASSWORD=<contraseña de la base>
DB_SSLMODE=require
DB_EMULATE_PREPARES=true
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
UPLOADS_DISK=s3
AWS_ACCESS_KEY_ID=<Supabase Storage: access key>
AWS_SECRET_ACCESS_KEY=<Supabase Storage: secret key>
AWS_DEFAULT_REGION=<región del proyecto de Supabase>
AWS_BUCKET=<nombre del bucket>
AWS_URL=<URL pública del bucket>
AWS_ENDPOINT=<endpoint S3 de Supabase>
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<usuario SMTP de Brevo>
MAIL_PASSWORD=<clave SMTP de Brevo>
MAIL_FROM_ADDRESS=<correo remitente verificado en Brevo>
MAIL_FROM_NAME=Distrito 3 Zona 13
GEMINI_API_KEY=<clave de Google AI Studio>
GEMINI_MODEL=gemini-3.8-flash
CRON_SECRET=<el mismo secreto que usa cron-job.org>
