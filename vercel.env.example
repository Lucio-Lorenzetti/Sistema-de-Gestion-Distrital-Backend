APP_ENV=production
APP_DEBUG=false
APP_KEY=CAMBIAR_APP_KEY
APP_URL=https://sistema-de-gestion-distrital-backen.vercel.app
FRONTEND_URL=https://distrito3zona13.vercel.app
CORS_ALLOWED_ORIGINS=https://distrito3zona13.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=CAMBIAR_DB_HOST
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=CAMBIAR_DB_USERNAME
DB_PASSWORD=CAMBIAR_DB_PASSWORD
DB_SSLMODE=require
DB_DISABLE_PREPARES=true
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
UPLOADS_DISK=s3
AWS_ACCESS_KEY_ID=CAMBIAR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CAMBIAR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=CAMBIAR_AWS_DEFAULT_REGION
AWS_BUCKET=CAMBIAR_AWS_BUCKET
AWS_URL=CAMBIAR_AWS_URL
AWS_ENDPOINT=CAMBIAR_AWS_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_MAIL_USERNAME
MAIL_PASSWORD=CAMBIAR_MAIL_PASSWORD
MAIL_FROM_ADDRESS=CAMBIAR_MAIL_FROM_ADDRESS
MAIL_FROM_NAME="Distrito 3 Zona 13"
GEMINI_API_KEY=CAMBIAR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
CRON_SECRET=CAMBIAR_CRON_SECRET
